  "credential_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {},
    "required": []
  },
  "model_requirement": {
    "id": "turn-model",
    "capability": "model-endpoint/openai-compatible",
    "accepted_compositions": [
      "model"
    ],
    "features": [
      "text-generation",
      "json-output"
    ],
    "model_id": null,
    "allowed_localities": [
      "local",
      "cloud"
